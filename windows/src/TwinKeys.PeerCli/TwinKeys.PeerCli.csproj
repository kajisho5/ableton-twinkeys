<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line TwinKeys peer for tests (docs/design-windows.md 6.6): runs TwinKeys.Core over real UDP
       on any OS, so CI can link it with the Swift Conductor on macOS. Not shipped to users. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TwinKeys.PeerCli</RootNamespace>
    <AssemblyName>twinkeys-peer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TwinKeys.Core/TwinKeys.Core.csproj" />
  </ItemGroup>
</Project>
