<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TwinKeys.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Colours of the approved mockups (docs/design/windows-*.svg), light and dark. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TkWindowBackground" Color="#202020" />
                    <SolidColorBrush x:Key="TkCardBackground" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="TkCardStroke" Color="#3B3B3B" />
                    <SolidColorBrush x:Key="TkText" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TkSecondaryText" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="TkTertiaryText" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="TkAccent" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="TkOnAccent" Color="#000000" />
                    <SolidColorBrush x:Key="TkSuccess" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="TkCaution" Color="#FCE100" />
                    <SolidColorBrush x:Key="TkCriticalText" Color="#FF99A4" />
                    <SolidColorBrush x:Key="TkSelectedRow" Color="#2D3A47" />
                    <SolidColorBrush x:Key="TkKeycapBackground" Color="#323232" />
                    <SolidColorBrush x:Key="TkKeycapStroke" Color="#5A5A5A" />
                    <SolidColorBrush x:Key="TkButtonBackground" Color="#373737" />
                    <SolidColorBrush x:Key="TkButtonStroke" Color="#454545" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TkWindowBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="TkCardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TkCardStroke" Color="#E1E1E1" />
                    <SolidColorBrush x:Key="TkText" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="TkSecondaryText" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="TkTertiaryText" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="TkAccent" Color="#005FB8" />
                    <SolidColorBrush x:Key="TkOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TkSuccess" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="TkCaution" Color="#9D5D00" />
                    <SolidColorBrush x:Key="TkCriticalText" Color="#C42B1C" />
                    <SolidColorBrush x:Key="TkSelectedRow" Color="#E5EFF9" />
                    <SolidColorBrush x:Key="TkKeycapBackground" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="TkKeycapStroke" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="TkButtonBackground" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="TkButtonStroke" Color="#D6D6D6" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- The red All Notes Off button is the same in both themes. -->
            <SolidColorBrush x:Key="TkCritical" Color="#C42B1C" />
            <SolidColorBrush x:Key="TkCriticalPointerOver" Color="#B12719" />
            <SolidColorBrush x:Key="TkCriticalPressed" Color="#9C2216" />
            <SolidColorBrush x:Key="TkWhite" Color="#FFFFFF" />
            <Style x:Key="TkCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TkCardBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TkCardStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="TkSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TkSecondaryText}" />
            </Style>
            <Style x:Key="TkHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TkSecondaryText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
