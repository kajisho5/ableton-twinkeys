<Project Sdk="Microsoft.NET.Sdk">
  <!--
    TwinKeys for Windows (WinUI 3). docs/design-windows.md chapters 3, 5 and 10.
    Packages (stable, exact versions):
      Microsoft.WindowsAppSDK 2.6.5    https://www.nuget.org/packages/Microsoft.WindowsAppSDK/2.6.5
      CommunityToolkit.Mvvm 8.4.2      https://www.nuget.org/packages/CommunityToolkit.Mvvm/8.4.2
    Two builds from this one project (docs/design-windows.md 7.2):
      - the unsigned, self-contained ZIP (unpackaged): the default, WindowsPackageType None;
      - the MSIX for the Microsoft Store: -p:WindowsPackageType=MSIX -p:GenerateAppxPackageOnBuild=true
        (see .github/workflows/windows.yml). Its identity comes from ../../StoreIdentity.props.
  -->
  <Import Project="../../StoreIdentity.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>TwinKeys.App</RootNamespace>
    <AssemblyName>TwinKeys</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TwinKeys.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <!-- As in the WinUI templates: without it no resources.pri is made, and WinUI cannot load any XAML (seen in CI). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>ja-JP</DefaultLanguage>
    <!-- Unpackaged app whose exe (TwinKeys.exe) is not named like the project: the resource index must be
         resources.pri, or WinUI finds neither App.xaml nor its own themeresources.xaml (seen in CI). -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <!-- The Store signs the package itself; CI signs a copy with a throwaway test certificate to install it. -->
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <AppxBundle Condition="'$(AppxBundle)' == ''">Never</AppxBundle>
    <_TwinKeysStampedManifest>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)msix\Package.appxmanifest</_TwinKeysStampedManifest>
  </PropertyGroup>
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <!-- The stamped copy of Package.appxmanifest (the SDK only picks Package.appxmanifest up when no
         AppxManifest item is given). -->
    <AppxManifest Include="$(_TwinKeysStampedManifest)" SubType="Designer" />
  </ItemGroup>
  <!-- Puts the StoreIdentity.props values into the manifest template. -->
  <Target Name="TwinKeysStampAppxManifest" BeforeTargets="PrepareForBuild" Condition="'$(WindowsPackageType)' == 'MSIX'">
    <Warning Condition="'$(StoreIdentityIsPlaceholder)' == 'true'"
             Text="StoreIdentity.props still has the REPLACE-ME placeholders: this MSIX installs for testing, but Partner Center will not accept it (docs/windows-store-submit.md)." />
    <PropertyGroup>
      <_TwinKeysAppxNs>&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;</_TwinKeysAppxNs>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_TwinKeysStampedManifest)'))" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Package.appxmanifest" DestinationFiles="$(_TwinKeysStampedManifest)" />
    <XmlPoke XmlInputPath="$(_TwinKeysStampedManifest)" Namespaces="$(_TwinKeysAppxNs)" Query="/m:Package/m:Identity/@Name" Value="$(StoreIdentityName)" />
    <XmlPoke XmlInputPath="$(_TwinKeysStampedManifest)" Namespaces="$(_TwinKeysAppxNs)" Query="/m:Package/m:Identity/@Publisher" Value="$(StoreIdentityPublisher)" />
    <XmlPoke XmlInputPath="$(_TwinKeysStampedManifest)" Namespaces="$(_TwinKeysAppxNs)" Query="/m:Package/m:Identity/@Version" Value="$(StorePackageVersion)" />
    <XmlPoke XmlInputPath="$(_TwinKeysStampedManifest)" Namespaces="$(_TwinKeysAppxNs)" Query="/m:Package/m:Properties/m:PublisherDisplayName" Value="$(StorePublisherDisplayName)" />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_TwinKeysStampedManifest)').Contains('@@Store'))" Text="Package.appxmanifest still has an @@Store... mark after stamping." />
    <Message Importance="high" Text="MSIX identity: $(StoreIdentityName) / $(StoreIdentityPublisher) / $(StorePublisherDisplayName), version $(StorePackageVersion)" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TwinKeys.Core/TwinKeys.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The texts are read by Platform/Strings.cs (so the language can change without a restart). -->
    <EmbeddedResource Include="Strings\ja-JP\Resources.resw" LogicalName="Strings.ja.resw" />
    <EmbeddedResource Include="Strings\en-US\Resources.resw" LogicalName="Strings.en.resw" />
    <!-- For the CI XAML check (Platform/XamlCheck.cs). -->
    <EmbeddedResource Include="Views\*.xaml" LogicalName="Xaml.%(Filename).xaml" />
    <EmbeddedResource Include="App.xaml" LogicalName="Xaml.App.xaml" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phase 2: the TwinKeysBridge Remote Script (the same files as the Mac app ships), installed into Live by Settings > Live. -->
    <Content Include="..\..\..\LiveBridge\TwinKeysBridge\*.py" Link="TwinKeysBridge\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
