<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: docs/design/windows-settings-dark.png and windows-settings-light.png (860 x 580). The pages are built in code. -->
<Window
    x:Class="TwinKeys.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource TkWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Width="16" Height="16" CornerRadius="3" Background="{ThemeResource TkAccent}">
                    <StackPanel Orientation="Horizontal" Spacing="1.6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Width="4.4" Height="10" RadiusX="1" RadiusY="1" Fill="{ThemeResource TkOnAccent}" />
                        <Rectangle Width="4.4" Height="10" RadiusX="1" RadiusY="1" Fill="{ThemeResource TkOnAccent}" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="220" SelectionChanged="OnNavigationChanged">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PagePanel" Padding="20,8,28,28" Spacing="12" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
