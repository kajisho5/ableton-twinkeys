<?xml version="1.0" encoding="utf-8"?>
<!-- First run: how cues reach Live (docs/design/windows-firstrun-dark.png, 640 x 540). -->
<Window
    x:Class="TwinKeys.App.Views.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource TkWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Width="16" Height="16" CornerRadius="3" Background="{ThemeResource TkAccent}">
                    <StackPanel Orientation="Horizontal" Spacing="1.6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Width="4.4" Height="10" RadiusX="1" RadiusY="1" Fill="{ThemeResource TkOnAccent}" />
                        <Rectangle Width="4.4" Height="10" RadiusX="1" RadiusY="1" Fill="{ThemeResource TkOnAccent}" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,20,24,24" Spacing="12">
                <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource TkHint}" FontSize="13" Margin="0,-6,0,4" />
                <StackPanel x:Name="Options" Spacing="12" />
                <Border Style="{StaticResource TkCardStyle}" Padding="16,8,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TestLabel" FontSize="14" TextWrapping="Wrap" />
                            <TextBlock x:Name="TestResult" Style="{StaticResource TkHint}" Visibility="Collapsed" />
                        </StackPanel>
                        <Button x:Name="TestButton" Grid.Column="1" MinWidth="120" Height="40" Click="OnTest" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="LaterButton" MinWidth="130" Height="40" Click="OnLater" />
                    <Button x:Name="NextButton" MinWidth="150" Height="40" Style="{StaticResource AccentButtonStyle}" Click="OnNext" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
