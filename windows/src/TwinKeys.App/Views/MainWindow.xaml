<?xml version="1.0" encoding="utf-8"?>
<!-- Main window: docs/design/windows-main-dark.png and windows-main-light.png (640 x 560). -->
<Window
    x:Class="TwinKeys.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource TkWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: app mark and name on the left; Windows draws minimize / maximize / close. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Width="16" Height="16" CornerRadius="3" Background="{ThemeResource TkAccent}">
                    <StackPanel Orientation="Horizontal" Spacing="1.6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Width="4.4" Height="10" RadiusX="1" RadiusY="1" Fill="{ThemeResource TkOnAccent}" />
                        <Rectangle Width="4.4" Height="10" RadiusX="1" RadiusY="1" Fill="{ThemeResource TkOnAccent}" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TitleText" Text="TwinKeys" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Connection line and All Notes Off. -->
        <Grid Grid.Row="1" Padding="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="LinkDot" Width="10" Height="10" Margin="3,0,13,0" VerticalAlignment="Center" Fill="{ThemeResource TkTertiaryText}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="LinkTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LinkDetail" FontSize="12" Foreground="{ThemeResource TkSecondaryText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="PanicButton" Grid.Column="2" Width="148" Height="32" FontWeight="SemiBold" Click="OnPanic">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackground" ResourceKey="TkCritical" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TkCriticalPointerOver" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TkCriticalPressed" />
                    <StaticResource x:Key="ButtonForeground" ResourceKey="TkWhite" />
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TkWhite" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TkWhite" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="TkCritical" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="TkCriticalPointerOver" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="TkCriticalPressed" />
                </Button.Resources>
            </Button>
        </Grid>
        <Rectangle Grid.Row="2" Height="1" Fill="{ThemeResource TkCardStroke}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,16,16,16" Spacing="0">
                <InfoBar x:Name="Banner" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,0,0,12" />

                <!-- Last cue -->
                <Border Style="{StaticResource TkCardStyle}" MinHeight="96" Padding="16,12,16,12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="LastCueTitle" Style="{StaticResource TkSectionTitle}" FontSize="12" />
                            <StackPanel x:Name="CueRow" Orientation="Horizontal" Spacing="12">
                                <Border x:Name="CueKeycap" MinWidth="44" Height="28" Padding="8,0,8,0" CornerRadius="5" BorderThickness="1"
                                        Background="{ThemeResource TkKeycapBackground}" BorderBrush="{ThemeResource TkKeycapStroke}">
                                    <TextBlock x:Name="CueKeyLabel" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CueMemo" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CueDetail" FontSize="12" Foreground="{ThemeResource TkSecondaryText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="NoCueText" Style="{StaticResource TkHint}" Visibility="Collapsed" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Fill="{ThemeResource TkCardStroke}" Margin="0,4,0,4" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Grid x:Name="DeliveryIcon" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0">
                                <Ellipse x:Name="DeliveryCircle" Fill="{ThemeResource TkSuccess}" />
                                <TextBlock x:Name="DeliveryGlyph" Text="✓" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TkCardBackground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel>
                                <TextBlock x:Name="DeliveryTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DeliveryDetail" FontSize="12" Foreground="{ThemeResource TkSecondaryText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Nearby TwinKeys -->
                <Grid Margin="4,16,4,8">
                    <TextBlock x:Name="NearbyTitle" Style="{StaticResource TkSectionTitle}" VerticalAlignment="Center" />
                    <HyperlinkButton x:Name="ConnectByIpLink" HorizontalAlignment="Right" Padding="4,2,4,2" FontSize="12" Click="OnConnectByIp" />
                </Grid>
                <Border Style="{StaticResource TkCardStyle}" Padding="1">
                    <StackPanel x:Name="PeerList" />
                </Border>

                <!-- Mode and keyboard -->
                <TextBlock x:Name="ModesTitle" Style="{StaticResource TkSectionTitle}" Margin="4,16,4,8" />
                <Border Style="{StaticResource TkCardStyle}" Padding="16,4,16,4">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SendKeysLabel" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="SendKeysHint" Grid.Column="1" Style="{StaticResource TkHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="SendKeysToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" Toggled="OnSendKeysToggled" />
                        <TextBlock x:Name="ReceiveLabel" Grid.Row="1" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="ReceiveHint" Grid.Row="1" Grid.Column="1" Style="{StaticResource TkHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="ReceiveToggle" Grid.Row="1" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" Toggled="OnReceiveToggled" />
                        <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Height="1" Fill="{ThemeResource TkCardStroke}" />
                        <TextBlock x:Name="CaptureLabel" Grid.Row="3" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="CaptureHint" Grid.Row="3" Grid.Column="1" Style="{StaticResource TkHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="CaptureToggle" Grid.Row="3" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" Toggled="OnCaptureToggled" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status line: MIDI output, Live, version. -->
        <Grid Grid.Row="4" BorderBrush="{ThemeResource TkCardStroke}" BorderThickness="0,1,0,0" Padding="20,12,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="MidiDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource TkTertiaryText}" />
                <TextBlock x:Name="MidiStatus" FontSize="12" Foreground="{ThemeResource TkSecondaryText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="LiveDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource TkTertiaryText}" />
                <TextBlock x:Name="LiveStatus" FontSize="12" Foreground="{ThemeResource TkSecondaryText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="VersionText" Grid.Column="2" FontSize="12" Foreground="{ThemeResource TkTertiaryText}" />
        </Grid>
    </Grid>
</Window>
