<Project>
  <!-- Shared settings for every Windows-version project (docs/design-windows.md, chapter 10). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Company>SEVENTHWELL</Company>
    <Product>TwinKeys</Product>
    <!-- The Windows version has its own number while it is a test version (not VERSION, which is the Mac app's). -->
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
