---
// "Try it": a working sample of TwinKeys Remote (GO and Session) and the Apple Watch app, with the two
// Macs and the connection map. Fictional data; nothing is sent anywhere. Design: docs/design-site-demo.md
// A switch shows the same sample for QLab instead (GO and the cue list; docs/design-qlab-demo.md, part B).
import { url, type Lang } from '../lib/i18n';
import { demoText } from '../lib/remote-demo-text';
import {
  demoData, initial, formatLeft, secondsLeft, progress, position, label, QCUES, QTYPE_SHORT, qDuration, qLabel,
} from '../lib/remote-demo';
import { mapSvg, mapSummary } from '../lib/remote-demo-map';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = demoText[lang];
const data = demoData(d.scenes);
// The page is built ahead of time: draw the first state at a fixed moment; the script takes over.
const now = 0;
const st = initial(data, now);
const left = secondsLeft(st, now);
const fill = (s: string, x: string) => s.replace('{x}', x).replace('{n}', x).replace('{name}', x);
const paneKeys = ['session', 'mixer', 'cues', 'go', 'settings'] as const;
const qPaneKeys = ['list', 'cues', 'go', 'settings'] as const;
const q = d.q;
const qn = q.cues;
// The QLab sample as first drawn (the script redraws it at once when QLab is chosen).
const qHead = 7; // 12 Distant rain
const qPlay = 8; // 13 Thunder 1
---
<section class="section section-alt demo" aria-labelledby="demo">
  <span id="demo-qlab" class="demo-anchor" aria-hidden="true"></span>
  <div class="wrap">
    <div class="demo-head">
      <div class="demo-head-t">
        <h2 class="section-title demo-title" id="demo">{d.title}</h2>
        <p class="demo-lead">{d.lead}</p>
      </div>
      <div class="mode-box" data-mode-box hidden>
        <div class="mode" role="group" aria-label={d.modeLabel}>
          <button data-mode="live" aria-pressed="true">{d.modeLive}</button>
          <button data-mode="qlab" aria-pressed="false">QLab</button>
        </div>
        <small>{d.modeHint}</small>
      </div>
    </div>

    <div class="demo-root" data-demo data-mode="live">
      <script type="application/json" data-demo-text set:html={JSON.stringify(d)} />
      <div class="demo-grid">
        <div class="phone">
          <div class="screen">
            <div class="app" data-el="app" data-pane="go">
              <header class="tb" data-show="live">
                <div class="tb-status">
                  <span class="dot ok" data-st="dot"></span>
                  <span class="tb-text">
                    <b data-st="macName">{d.mainMac}</b>
                    <small data-st="statusLine">{d.statusOk}</small>
                  </span>
                </div>
                <div class="tb-transport">
                  <button class="tbtn play" data-act="play" aria-label={d.play}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z" /></svg>
                  </button>
                  <button class="tbtn stop" data-hold="stop" aria-label={d.stop}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1.5" /></svg>
                    <span class="holdfill" aria-hidden="true"></span>
                  </button>
                  <span class="tempo">124.00<small>BPM</small></span>
                  <span class="pos" data-el="pos">{position(st, now)}</span>
                </div>
                <div class="tb-right">
                  <button class="anf" data-act="notesOff">{d.allNotesOff}</button>
                  <button class="lockbtn" data-lock aria-label={d.lock} aria-pressed="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path class="shackle" d="M8 11V8a4 4 0 0 1 8 0" fill="none" stroke-width="2.2" />
                      <rect x="5.5" y="11" width="13" height="9" rx="2" />
                    </svg>
                    <span class="holdfill" aria-hidden="true"></span>
                  </button>
                </div>
              </header>
              <header class="tb tb-q" data-show="qlab">
                <div class="tb-status">
                  <span class="dot ok" data-st="dot"></span>
                  <span class="tb-text">
                    <b data-st="macName">{d.mainMac}</b>
                    <small data-st="statusLine">{q.statusOk}</small>
                  </span>
                </div>
                <div class="tb-chips">
                  <span class="chip"><small>{q.workspace}</small><b>sample-show</b></span>
                  <span class="chip"><small>{q.runningCap}</small><b data-el="qRunN">{q.runningN.replace('{n}', '2')}</b></span>
                  <span class="chip"><small>{q.listCap}</small><b>Main</b></span>
                </div>
                <div class="tb-right">
                  <button class="anf" data-act="qpanic" aria-label={q.panicAria}>{q.panic}</button>
                  <button class="lockbtn" data-lock aria-label={d.lock} aria-pressed="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path class="shackle" d="M8 11V8a4 4 0 0 1 8 0" fill="none" stroke-width="2.2" />
                      <rect x="5.5" y="11" width="13" height="9" rx="2" />
                    </svg>
                    <span class="holdfill" aria-hidden="true"></span>
                  </button>
                </div>
              </header>

              <div class="body">
                <div class="content">
                  <div class="banner lost" data-el="lost" hidden>
                    <span data-el="lostText">{fill(d.lostBanner, '3')}</span>
                    <button data-act="askSwitch">{d.switchButton}</button>
                  </div>
                  <div class="banner switched" data-el="switchedBanner" hidden>{fill(d.switchedBanner, d.backupMac)}</div>
                  <div class="notice" data-el="notice" hidden></div>

                  <div class="pane pane-go">
                    <div class="go-left">
                      <div class="card now" data-el="now">
                        <span class="cap ok">{d.nowPlaying}</span>
                        <div class="row big">
                          <span class="idx" data-el="nowIdx">{st.playing !== null ? st.playing + 1 : ''}</span>
                          <span class="nm" data-el="nowName">{st.playing !== null ? data.scenes[st.playing] : d.nothingPlaying}</span>
                        </div>
                        <div class="row left" data-el="nowLeftRow">
                          <span class="cap2">{d.left}</span>
                          <span class="leftv" data-el="nowLeft">{left !== null ? formatLeft(left) : ''}</span>
                          <span class="bar"><span data-el="nowBar" style={`width:${Math.round(progress(st, now) * 100)}%`}></span></span>
                        </div>
                      </div>
                      <div class="card next">
                        <span class="cap acc">{d.next}</span>
                        <div class="row big2">
                          <span class="idx" data-el="nextIdx">{st.next + 1}</span>
                          <span class="nm" data-el="nextName">{data.scenes[st.next]}</span>
                        </div>
                      </div>
                      <div class="spacer"></div>
                      <div class="choose">
                        <button data-act="back">{d.back}</button>
                        <button data-act="fwd">{d.fwd}</button>
                        <span>{d.chooseOnly}</span>
                      </div>
                    </div>
                    <button class="gobtn" data-act="go">
                      <span class="go-big">GO</span>
                      <span class="go-sub">{d.goSub}</span>
                      <span class="go-next" data-el="goNext">{label(data, st.next)}</span>
                      <span class="go-lock">{d.goLock}</span>
                    </button>
                  </div>

                  <div class="pane pane-session">
                    <div class="grid" role="group" aria-label={d.panes.session} style={`--cols:${data.tracks.length}`}>
                      <div class="gh" aria-hidden="true">
                        <span class="gn"></span>
                        {data.tracks.map((tr, t) => <span class="th" style={`--c:${data.colors[t]}`}>{tr}</span>)}
                        <span class="th scene-h">{d.sceneHeader}</span>
                      </div>
                      {data.scenes.map((sc, s) => (
                        <div class="gr">
                          <span class="gn" title={sc}>{s + 1}</span>
                          {data.tracks.map((tr, t) => {
                            const c = data.clips[t][s];
                            return (
                              <button
                                class:list={['slot', c.has ? 'has' : 'empty']}
                                style={`--c:${data.colors[t]}`}
                                data-act="slot"
                                data-t={t}
                                data-s={s}
                                aria-label={c.has ? `${tr} · ${c.name} (${s + 1} ${sc})` : fill(d.stopTrack, tr)}
                              >
                                {c.has ? <span class="cn">{c.name}</span> : <span class="sq" aria-hidden="true"></span>}
                                {c.has && <span class="cl" data-left></span>}
                              </button>
                            );
                          })}
                          <button class="scbtn" data-act="scene" data-s={s} aria-label={fill(d.launchScene, String(s + 1))}>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="pane pane-qgo">
                    <div class="go-left">
                      <div class="card now" data-el="qNow">
                        <span class="cap ok">{q.nowPlaying}</span>
                        <div class="row big">
                          <span class="idx" data-el="qNowIdx">{QCUES[qHead].number}</span>
                          <span class="nm" data-el="qNowName">{qn[qHead]}</span>
                        </div>
                        <div class="row left" data-el="qNowLeftRow">
                          <span class="cap2">{q.left}</span>
                          <span class="leftv" data-el="qNowLeft">-1:03</span>
                          <span class="bar"><span data-el="qNowBar" style="width:69%"></span></span>
                        </div>
                      </div>
                      <div class="card next q-next" data-el="qNextCard">
                        <span class="cap acc">{q.next}</span>
                        <div class="row big2">
                          <span class="idx" data-el="qNextIdx">{QCUES[qPlay].number}</span>
                          <span class="nm" data-el="qNextName">{qn[qPlay]}</span>
                        </div>
                        <span class="bk" data-el="qBackup">{q.backupToo.replace('{n}', QCUES[qPlay].number)}</span>
                      </div>
                      <div class="spacer"></div>
                      <div class="qbtns">
                        <button data-act="qback"><b>{q.back}</b><small>{q.playhead}</small></button>
                        <button data-act="qfwd"><b>{q.fwd}</b><small>{q.playhead}</small></button>
                        <button class="qstop" data-hold="qstop" aria-label={q.stopAria}>
                          <span class="holdfill" aria-hidden="true"></span>
                          <b>{q.stop}</b><small>{q.stopSub}</small>
                        </button>
                      </div>
                    </div>
                    <button class="gobtn qgo" data-act="qgo" aria-label={q.goAria.replace('{x}', qLabel(qn, qPlay))}>
                      <span class="go-cap" aria-hidden="true">{q.goCap}</span>
                      <span class="go-big" aria-hidden="true">GO</span>
                      <span class="go-sub" aria-hidden="true">{q.goSub}</span>
                      <span class="go-next" data-el="qGoNext" aria-hidden="true">{qLabel(qn, qPlay)}</span>
                      <span class="go-lock" data-el="qLast">{q.lastGo.replace('{x}', QCUES[qHead].number)}</span>
                    </button>
                  </div>

                  <div class="pane pane-qlist">
                    <div class="ql-head">
                      <span class="ql-count">{q.listCount.replace('{n}', String(QCUES.length))}</span>
                      <input class="ql-search" data-el="qSearch" type="search" placeholder={q.search} aria-label={q.search} autocomplete="off" />
                      <button class="ql-follow on" data-act="qfollow" aria-pressed="true" aria-label={q.followAria}>{q.follow}</button>
                    </div>
                    <div class="ql-rows" data-el="qRows">
                      {QCUES.map((c, i) => (
                        <button
                          class:list={['qrow', `qd${c.depth}`, { grp: c.type === 'group', playing: i === qHead || i === 6, next: i === qPlay }]}
                          data-act="qrow"
                          data-i={i}
                          data-find={`${c.number} ${qn[i]}`.toLowerCase()}
                        >
                          <span class="qn"><span class="qm" aria-hidden="true"></span>{c.number}</span>
                          <span class:list={['qt', `qt-${c.type}`]} title={q.types[c.type]}>{QTYPE_SHORT[c.type]}</span>
                          <span class="qname">{qn[i]}</span>
                          <span class="qleft" data-left></span>
                          <span class="qdur">{qDuration(c)}</span>
                        </button>
                      ))}
                      <p class="ql-none" data-el="qNone" hidden>{q.noMatch}</p>
                    </div>
                    <p class="ql-hint">{q.listHint}</p>
                  </div>
                </div>

                <nav class="rail" aria-label="TwinKeys Remote" data-show="live">
                  {paneKeys.map((k) => {
                    const live = k === 'session' || k === 'go';
                    return (
                      <button
                        class:list={['ri', `ri-${k}`, { on: k === 'go' }]}
                        data-act={live ? 'pane' : 'paneOff'}
                        data-pane={k}
                        aria-disabled={live ? undefined : 'true'}
                        title={live ? undefined : d.paneOff}
                        aria-current={k === 'go' ? 'page' : undefined}
                      >
                        <span class="rico" aria-hidden="true"></span>
                        <span class="rl">{d.panes[k]}</span>
                      </button>
                    );
                  })}
                </nav>
                <nav class="rail" aria-label="TwinKeys Remote · QLab" data-show="qlab">
                  {qPaneKeys.map((k) => {
                    const live = k === 'list' || k === 'go';
                    return (
                      <button
                        class:list={['ri', `ri-${k}`, { on: k === 'go' }]}
                        data-act={live ? 'pane' : 'paneOff'}
                        data-pane={k}
                        aria-disabled={live ? undefined : 'true'}
                        title={live ? undefined : d.paneOff}
                        aria-current={k === 'go' ? 'page' : undefined}
                      >
                        <span class="rico" aria-hidden="true"></span>
                        <span class="rl">{q.panes[k]}</span>
                      </button>
                    );
                  })}
                </nav>
              </div>

              <div class="sheet" data-el="sheet" hidden role="dialog" aria-modal="true" aria-labelledby="demo-sheet-t">
                <div class="sheet-box">
                  <b id="demo-sheet-t">{d.confirmTitle}</b>
                  <p>{fill(d.confirmBody, d.backupMac)}</p>
                  <p class="pt">{fill(d.confirmPhone, d.backupMac)}</p>
                  <p class="pt">{fill(d.confirmKeys, d.backupMac)}</p>
                  <div class="sheet-btns">
                    <button class="cancel" data-act="cancel">{d.cancel}</button>
                    <button class="holdbtn" data-hold="switch">
                      <span class="holdfill" aria-hidden="true"></span>
                      <span class="hb-t">{d.hold}</span>
                      <small>{d.holdSecond}</small>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="side">
          <div class="watch-row">
            <div class="watch-wrap">
              <div class="watch" aria-label={d.watchTitle} role="group">
                <span class="crown" aria-hidden="true"></span><span class="sidebtn" aria-hidden="true"></span>
                <div class="wscreen" data-el="wscreen" data-page="0">
                  <div class="wpage wp0" data-show="live">
                    <span class="wnext" data-el="wnext">{fill(d.watchNext, label(data, st.next))}</span>
                    <button class="wgo" data-act="go" aria-label={`GO: ${label(data, st.next)}`}>GO</button>
                    <span class="whint" data-el="whint">{d.crownHint}</span>
                  </div>
                  <div class="wpage wp1" data-show="live">
                    <span class="wcap" data-el="wcap1">{d.chooseScene}</span>
                    <div class="wlist">
                      {data.scenes.map((sc, s) => (
                        <button class="wsc" data-act="wselect" data-s={s}>
                          <span class="wn">{s + 1}</span><span class="wt">{sc}</span><span class="wm" aria-hidden="true"></span>
                        </button>
                      ))}
                    </div>
                  </div>
                  <div class="wpage wp2" data-show="live">
                    <span class="wlinks" data-el="wlinks">{d.watchLinks}</span>
                    <button class="wanf" data-act="notesOff">{d.allNotesOff}</button>
                    <span class="wlast" data-el="wlast">{d.lastCueNone}</span>
                  </div>
                  <div class="wpage wq0" data-show="qlab">
                    <span class="wlamps" aria-hidden="true">
                      <span class="lm" data-lamp="m">M</span><span class="lm" data-lamp="b">B</span><span class="lm" data-lamp="q">Q</span>
                    </span>
                    <span class="wnow" data-el="wqNow">{qLabel(qn, qHead)}</span>
                    <button class="wgo wqgo" data-act="qgo" aria-label={q.goAria.replace('{x}', qLabel(qn, qPlay))}>
                      <span aria-hidden="true">GO</span>
                      <small data-el="wqLeft" aria-hidden="true">-1:03</small>
                    </button>
                    <span class="whint" data-el="wqNext">{d.watchNext.replace('{x}', qLabel(qn, qPlay))}</span>
                  </div>
                  <div class="wpage wq1" data-show="qlab">
                    <span class="wcap">{q.chooseCue}</span>
                    <div class="wlist" data-el="wqList">
                      {QCUES.map((c, i) =>
                        c.type === 'group' ? (
                          <span class="wgrp">{c.number} {qn[i]}</span>
                        ) : (
                          <button class="wsc" data-act="qrow" data-i={i}>
                            <span class="wn">{c.number}</span><span class="wt">{qn[i]}</span><span class="wm" aria-hidden="true"></span>
                          </button>
                        ),
                      )}
                    </div>
                  </div>
                  <div class="wpage wq2" data-show="qlab">
                    <span class="wlinks" data-el="wqLinks">{q.lamps}</span>
                    <button class="wanf" data-act="qpanic" aria-label={q.panicAria}>PANIC</button>
                    <span class="wlast" data-el="wqLast">{q.lastGo.replace('{x}', QCUES[qHead].number)}</span>
                  </div>
                </div>
              </div>
              <div class="dots" role="group" aria-label={d.watchTitle}>
                {d.watchPages.map((p, i) => (
                  <button class:list={['wdot', { on: i === 0 }]} data-act="wpage" data-p={i} aria-label={p} aria-pressed={i === 0 ? 'true' : 'false'}></button>
                ))}
              </div>
            </div>
            <div class="watch-copy">
              <b>{d.watchTitle}</b>
              <p data-show="live">{d.watchDesc}</p>
              <p data-show="qlab">{q.watchDesc}</p>
              <p>{d.watchHint}</p>
              <div class="crown-btns">
                <button data-act="back">{d.crownBack}</button>
                <button data-act="fwd">{d.crownNext}</button>
              </div>
              <small>{d.crownNote}</small>
            </div>
          </div>

          <div class="macs">
            {(['main', 'backup'] as const).map((k) => (
              <div class="mac ok" data-el={`mac-${k}`}>
                <div class="mac-h">
                  <svg viewBox="0 0 28 22" aria-hidden="true"><rect x="2" y="2" width="24" height="15" rx="2.5" /><rect x="10" y="18" width="8" height="2.5" /></svg>
                  <b>{k === 'main' ? d.mainMac : d.backupMac}</b>
                </div>
                <div class="mac-s">
                  <span class="mac-live" data-part="live">● {d.liveOk}</span>
                  <span class="mac-badge" data-part="badge" hidden={k !== 'main'}>{d.mainBadge}</span>
                </div>
                <div class="mac-line" data-part="line">▶ {st.playing !== null ? label(data, st.playing) : ''}</div>
                <div class="mac-standby" data-part="standby" data-show="qlab"></div>
                <div class="mac-recv" data-part="recv" aria-hidden="true"></div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="map" data-el="map">
        <b class="map-title">{d.mapTitle}</b>
        <div class="map-pics" data-el="mapPics" role="img" aria-label={mapSummary('ok', d)}>
          <Fragment set:html={mapSvg('ok', d, false) + mapSvg('ok', d, true)} />
        </div>
      </div>

      <div class="controls">
        <button class="ctl stopmain" data-act="stopMain">{d.stopMain}</button>
        <button class="ctl" data-act="reset">{d.reset}</button>
        <p data-show="live">{d.controlsNote1}<br />{d.controlsNote2}</p>
        <p data-show="qlab">{q.controlsNote1}<br />{d.controlsNote2}</p>
      </div>
      <p class="foot" data-show="live">{d.foot1}<br />{d.foot2}</p>
      <p class="foot" data-show="qlab">{q.foot1}<br />{q.foot2}</p>
      <p class="sr-only" aria-live="polite" data-el="live"></p>
    </div>

    <noscript>
      <img class="demo-fallback" src={url('images/remote-session.png')} width="1311" height="603" alt={d.fallbackAlt} loading="lazy" />
    </noscript>
  </div>
</section>

<script>
  import {
    demoData, initial, go, select, fireScene, tapSlot, play, stop, allNotesOff, hint, setLock, setPane,
    setWatchPage, setMode, stopMain, askSwitch, cancelSwitch, switchToBackup, secondsLeft, progress, formatLeft,
    position, showsLostBanner, lostSeconds, linkState, visibleNotice, recentEvent, label, reachable,
    QCUES, qRunning, qLeft, qProgress, qGo, qSetPlayhead, qBack, qNext, qPanic, qStop, qLabel, qPlayable,
    type DemoState, type Pane, type WatchPage, type Mode, type EventKind, type NoticeKind,
  } from '../lib/remote-demo';
  import { mapSvg, mapSummary, type QLabSubs } from '../lib/remote-demo-map';
  import type { DemoText } from '../lib/remote-demo-text';

  const HOLD_MS = 1000;
  const QLAB_HASH = '#demo-qlab';

  function start(root: HTMLElement) {
    const t: DemoText = JSON.parse(root.querySelector('[data-demo-text]')!.textContent || '{}');
    const data = demoData(t.scenes);
    const names = t.q.cues;
    const hashMode = (): Mode => (location.hash === QLAB_HASH ? 'qlab' : 'live');
    let s: DemoState = initial(data, Date.now(), hashMode());
    let lastMap = '';
    let lastLive = '';
    // View-only choices of the cue list (as in the app, they are not sent anywhere).
    let follow = true;
    let query = '';
    let lastScroll = '';
    const el = <T extends HTMLElement = HTMLElement>(name: string) => root.querySelector<T>(`[data-el="${name}"]`)!;
    const all = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));
    const fill = (str: string, x: string) => str.replace('{x}', x).replace('{n}', x).replace('{name}', x);
    const modeBox = root.closest('section')?.querySelector<HTMLElement>('[data-mode-box]') ?? null;
    const announce = (msg: string) => {
      if (msg === lastLive) return;
      lastLive = msg;
      el('live').textContent = msg;
    };
    const eventName = (k: EventKind): string => {
      if (s.mode === 'qlab' && (k === 'playhead' || k === 'panic' || k === 'stop')) return t.q.events[k];
      return k === 'playhead' || k === 'panic' ? t.q.events[k] : t.events[k];
    };
    const noticeText = (k: NoticeKind): string => {
      if (k === 'panic' || k === 'stopped') return t.q.notice[k];
      if (k === 'end' && s.mode === 'qlab') return t.q.notice.end;
      return t.notice[k];
    };

    function set(n: DemoState, msg?: string) {
      s = n;
      render();
      if (msg) announce(msg);
    }

    function render() {
      const now = Date.now();
      const qlab = s.mode === 'qlab';
      root.dataset.mode = s.mode;
      const app = el('app');
      app.dataset.pane = s.pane;
      app.dataset.mode = s.mode;
      if (modeBox) {
        modeBox.querySelectorAll<HTMLElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === s.mode)));
      }
      // top bar
      const ls = linkState(s);
      all('[data-st="macName"]').forEach((e) => (e.textContent = s.switched ? t.backupMac : t.mainMac));
      all('[data-st="statusLine"]').forEach((e) => {
        e.textContent = ls === 'ok' ? (qlab ? t.q.statusOk : t.statusOk) : ls === 'dead' ? t.statusLost : t.statusSwitched;
        e.className = ls === 'dead' ? 'bad' : ls === 'switched' ? 'warn' : '';
      });
      all('[data-st="dot"]').forEach((e) => (e.className = `dot ${ls === 'dead' ? 'bad' : ls === 'switched' ? 'warn' : 'ok'}`));
      all('[data-lock]').forEach((lock) => {
        lock.classList.toggle('on', s.locked);
        lock.setAttribute('aria-pressed', String(s.locked));
        lock.setAttribute('aria-label', s.locked ? t.unlock : t.lock);
      });
      // banners and notices
      el('lost').hidden = !showsLostBanner(s, now);
      el('lostText').textContent = fill(t.lostBanner, String(lostSeconds(s, now)));
      el('switchedBanner').hidden = !(s.switched && now - (s.notice?.at ?? 0) < 6000 && s.notice?.kind === 'switched');
      const nk = visibleNotice(s, now);
      const notice = el('notice');
      notice.hidden = !nk || nk === 'switched';
      notice.textContent = nk ? noticeText(nk) : '';
      notice.className = `notice ${nk === 'unreachable' ? 'bad' : ''}`;
      el('sheet').hidden = !s.confirming;
      all('[data-act="pane"]').forEach((b) => {
        const on = b.dataset.pane === s.pane;
        b.classList.toggle('on', on);
        if (on) b.setAttribute('aria-current', 'page'); else b.removeAttribute('aria-current');
      });
      // watch pages
      el('wscreen').dataset.page = String(s.watchPage);
      const pages = qlab ? t.q.watchPages : t.watchPages;
      all('[data-act="wpage"]').forEach((b) => {
        const on = Number(b.dataset.p) === s.watchPage;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
        b.setAttribute('aria-label', pages[Number(b.dataset.p)]);
      });
      if (qlab) renderQLab(now, nk);
      else renderLive(now, nk);
      // Macs: what both received
      const recent = recentEvent(s, now);
      for (const k of ['main', 'backup'] as const) {
        const card = el(`mac-${k}`);
        const dead = k === 'main' && s.main === 'dead';
        card.className = `mac ${dead ? 'dead' : 'ok'}`;
        card.querySelector('[data-part="live"]')!.textContent = dead ? `● ${t.noAnswer}` : `● ${qlab ? t.q.qlabOk : t.liveOk}`;
        const isMain = (k === 'main' && !s.switched) || (k === 'backup' && s.switched);
        (card.querySelector('[data-part="badge"]') as HTMLElement).hidden = !isMain || dead;
        const recv = card.querySelector('[data-part="recv"]') as HTMLElement;
        const got = !!recent && !dead && reachable(s);
        recv.textContent = got ? fill(t.received, eventName(recent!.kind)) : '';
        recv.classList.toggle('on', got);
      }
      (root.querySelector('[data-act="stopMain"]') as HTMLButtonElement).disabled = s.main === 'dead';
    }

    function renderMap(key: string, subs?: QLabSubs) {
      if (key === lastMap) return;
      lastMap = key;
      const ls = linkState(s);
      const pics = el('mapPics');
      pics.innerHTML = mapSvg(ls, t, false, subs) + mapSvg(ls, t, true, subs);
      pics.setAttribute('aria-label', mapSummary(ls, t, subs));
    }

    function renderLive(now: number, nk: NoticeKind | null) {
      el('pos').textContent = position(s, now);
      root.querySelector('[data-act="play"]')!.classList.toggle('on', s.running);
      // GO pane
      const left = secondsLeft(s, now);
      el('nowIdx').textContent = s.playing !== null ? String(s.playing + 1) : '';
      el('nowName').textContent = s.playing !== null ? data.scenes[s.playing] : t.nothingPlaying;
      el('now').classList.toggle('idle', s.playing === null);
      el('nowLeftRow').hidden = left === null;
      el('nowLeft').textContent = left !== null ? formatLeft(left) : '';
      el('nowBar').style.width = `${Math.round(progress(s, now) * 100)}%`;
      const hasNext = s.next >= 0 && s.next < data.scenes.length;
      el('nextIdx').textContent = hasNext ? String(s.next + 1) : '';
      el('nextName').textContent = hasNext ? data.scenes[s.next] : t.endOfList;
      el('goNext').textContent = hasNext ? label(data, s.next) : t.endOfList;
      all('[data-act="go"]').forEach((b) => {
        b.classList.toggle('end', !hasNext);
        b.setAttribute('aria-disabled', String(!hasNext));
      });
      all('[data-act="back"]').forEach((b) => b.toggleAttribute('disabled', s.next <= 0));
      all('[data-act="fwd"]').forEach((b) => b.toggleAttribute('disabled', s.next >= data.scenes.length - 1));
      // session
      all('[data-act="slot"]').forEach((b) => {
        const tr = Number(b.dataset.t), sc = Number(b.dataset.s);
        const on = s.trackSlot[tr] === sc;
        b.classList.toggle('playing', on);
        const lt = b.querySelector('[data-left]');
        if (lt) lt.textContent = on && left !== null ? formatLeft(left) : '';
      });
      all('[data-act="scene"]').forEach((b) => b.classList.toggle('on', Number(b.dataset.s) === s.playing));
      all('.gr').forEach((r, i) => r.classList.toggle('sel', i === s.next));
      // watch
      el('wnext').textContent = hasNext ? fill(t.watchNext, label(data, s.next)) : t.endOfList;
      const wgo = root.querySelector('.wgo')!;
      wgo.setAttribute('aria-label', hasNext ? `GO: ${label(data, s.next)}` : `GO: ${t.endOfList}`);
      el('whint').textContent = nk && nk !== 'switched' ? noticeText(nk) : t.crownHint;
      el('whint').className = `whint ${nk === 'unreachable' ? 'bad' : ''}`;
      all('[data-act="wselect"]').forEach((b) => {
        const sc = Number(b.dataset.s);
        b.classList.toggle('playing', sc === s.playing);
        b.classList.toggle('next', sc === s.next);
      });
      el('wlinks').textContent = reachable(s) ? (s.switched ? `${t.backupMac} ✓` : t.watchLinks) : t.watchLinksLost;
      const ev = s.lastEvent;
      el('wlast').textContent = ev ? fill(t.lastCue, eventName(ev.kind)) : t.lastCueNone;
      // Macs
      for (const k of ['main', 'backup'] as const) {
        const card = el(`mac-${k}`);
        const dead = k === 'main' && s.main === 'dead';
        card.querySelector('[data-part="line"]')!.textContent = dead
          ? t.stoppedNote
          : s.playing !== null ? `▶ ${label(data, s.playing)}` : t.stoppedLine;
      }
      renderMap(`live|${linkState(s)}`);
    }

    function renderQLab(now: number, nk: NoticeKind | null) {
      const q = s.ql;
      const run = qRunning(q, now);
      const cur = run[0] ?? null;
      const p = q.playhead;
      el('qRunN').textContent = fill(t.q.runningN, String(run.length));
      // GO pane: now playing
      el('qNow').classList.toggle('idle', !cur);
      el('qNowIdx').textContent = cur ? QCUES[cur.i].number : '';
      el('qNowName').textContent = cur ? names[cur.i] : t.q.noneRunning;
      el('qNowLeftRow').hidden = !cur;
      el('qNowLeft').textContent = cur ? formatLeft(qLeft(cur, now)) : '';
      el('qNowBar').style.width = cur ? `${Math.round(qProgress(cur, now) * 100)}%` : '0%';
      // next, and where the backup stands
      el('qNextCard').classList.toggle('idle', p === null);
      el('qNextIdx').textContent = p !== null ? QCUES[p].number : '';
      el('qNextName').textContent = p !== null ? names[p] : t.q.noneNext;
      const bk = el('qBackup');
      bk.hidden = p === null;
      bk.textContent = s.main === 'dead' ? t.q.mainLost : p !== null ? fill(t.q.backupToo, QCUES[p].number) : '';
      bk.className = `bk ${s.main === 'dead' ? 'warn' : ''}`;
      el('qGoNext').textContent = p !== null ? qLabel(names, p) : t.q.notice.end;
      const goLabel = fill(t.q.goAria, p !== null ? qLabel(names, p) : t.q.notice.end);
      all('[data-act="qgo"]').forEach((b) => {
        b.classList.toggle('end', p === null);
        b.setAttribute('aria-disabled', String(p === null));
        b.setAttribute('aria-label', goLabel);
      });
      const lastText = q.last
        ? fill(s.main === 'dead' && s.lostAt !== null && q.last.at >= s.lostAt ? t.q.lastGoLost : t.q.lastGo, QCUES[q.last.i].number)
        : t.q.lastGoNone;
      el('qLast').textContent = lastText;
      const first = qPlayable(0);
      all('[data-act="qback"]').forEach((b) => b.toggleAttribute('disabled', p !== null && p === first));
      all('[data-act="qfwd"]').forEach((b) => b.toggleAttribute('disabled', p === null || qPlayable(p + 1) === null));
      all('[data-act="back"]').forEach((b) => b.toggleAttribute('disabled', p !== null && p === first));
      all('[data-act="fwd"]').forEach((b) => b.toggleAttribute('disabled', p === null || qPlayable(p + 1) === null));
      // the cue list (phone and watch)
      const needle = query.trim().toLowerCase();
      let shown = 0;
      all('[data-act="qrow"]').forEach((b) => {
        const i = Number(b.dataset.i);
        const r = run.find((x) => x.i === i);
        const isNext = i === p;
        b.classList.toggle('playing', !!r);
        b.classList.toggle('next', isNext);
        b.classList.toggle('done', !r && !isNext && p !== null && i < p);
        const lt = b.querySelector('[data-left]');
        if (lt) {
          lt.textContent = r ? formatLeft(qLeft(r, now)) : isNext ? t.q.nextTag : '';
          const hide = !!needle && !(b.dataset.find ?? '').includes(needle);
          b.hidden = hide;
          if (!hide) shown++;
        }
        const state = r ? `, ${t.q.nowPlaying}` : isNext ? `, ${t.q.next}` : '';
        const al = `${qLabel(names, i)}, ${t.q.types[QCUES[i].type]}${state}`;
        if (b.getAttribute('aria-label') !== al) b.setAttribute('aria-label', al);
      });
      el('qNone').hidden = shown > 0;
      const fb = root.querySelector<HTMLElement>('[data-act="qfollow"]')!;
      fb.classList.toggle('on', follow);
      fb.setAttribute('aria-pressed', String(follow));
      // Follow: keep the playhead in the middle of the list (inside the list only; the page does not move).
      const key = `${s.pane}|${p}|${needle}`;
      if (follow && !needle && s.pane === 'list' && key !== lastScroll && p !== null) {
        const rows = el('qRows');
        const row = rows.querySelector<HTMLElement>(`.qrow[data-i="${p}"]`);
        if (row) rows.scrollTop = row.offsetTop - rows.clientHeight / 2 + row.offsetHeight / 2;
      }
      lastScroll = key;
      // watch
      const lamps: Record<string, boolean> = { m: s.main === 'ok', b: true, q: true };
      all('[data-lamp]').forEach((l) => l.classList.toggle('bad', !lamps[l.dataset.lamp!]));
      el('wqNow').textContent = cur ? qLabel(names, cur.i) : t.q.noneRunning;
      el('wqLeft').textContent = cur ? formatLeft(qLeft(cur, now)) : '';
      el('wqNext').textContent = nk && nk !== 'switched' ? noticeText(nk) : p !== null ? fill(t.watchNext, qLabel(names, p)) : t.q.notice.end;
      el('wqNext').className = `whint ${nk === 'unreachable' ? 'bad' : ''}`;
      el('wqLinks').textContent = reachable(s) ? (s.switched ? `${t.backupMac} ✓` : t.q.lamps) : t.q.lampsLost;
      el('wqLast').textContent = lastText;
      if (s.watchPage === 1 && follow && p !== null) {
        const wl = el('wqList');
        const wr = wl.querySelector<HTMLElement>(`[data-i="${p}"]`);
        const wkey = `w|${p}`;
        if (wr && wl.dataset.scrolled !== wkey) {
          wl.scrollTop = wr.offsetTop - wl.offsetTop - wl.clientHeight / 2 + wr.offsetHeight / 2;
          wl.dataset.scrolled = wkey;
        }
      }
      // Macs: what plays and what stands by (the same on both)
      const playing = cur ? `▶ ${qLabel(names, cur.i)}` : t.q.nothingRunning;
      for (const k of ['main', 'backup'] as const) {
        const card = el(`mac-${k}`);
        const dead = k === 'main' && s.main === 'dead';
        card.querySelector('[data-part="line"]')!.textContent = dead ? t.stoppedNote : playing;
        card.querySelector('[data-part="standby"]')!.textContent = !dead && p !== null ? fill(t.q.standby, qLabel(names, p)) : '';
      }
      const sub = cur ? `▶ ${QCUES[cur.i].number} ${names[cur.i]}` : t.q.qlabStopped;
      renderMap(`qlab|${linkState(s)}|${sub}`, { main: sub, backup: sub });
    }

    function chooseMode(mode: Mode) {
      if (mode === s.mode) return;
      lastMap = '';
      lastScroll = '';
      query = '';
      el<HTMLInputElement>('qSearch').value = '';
      set(setMode(data, s, mode, Date.now()), mode === 'qlab' ? t.q.live.mode : t.q.live.modeLive);
      const hash = mode === 'qlab' ? QLAB_HASH : '';
      if (location.hash !== hash) history.replaceState(history.state, '', `${location.pathname}${location.search}${hash}`);
    }
    if (modeBox) {
      modeBox.hidden = false;
      modeBox.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mode]');
        if (b) chooseMode(b.dataset.mode as Mode);
      });
    }
    window.addEventListener('hashchange', () => {
      if (location.hash === QLAB_HASH) chooseMode('qlab');
    });

    // taps
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
      if (!b || !root.contains(b) || b.hasAttribute('disabled')) return;
      const now = Date.now();
      const act = b.dataset.act;
      const qlab = s.mode === 'qlab';
      switch (act) {
        case 'go': {
          const n = go(data, s, now);
          set(n, n.lastEvent?.kind === 'go' && n !== s ? fill(t.live.go, label(data, n.playing ?? 0)) : undefined);
          break;
        }
        case 'back':
          if (qlab) moved(qBack(names, s, now));
          else set(select(data, s, s.next - 1, now), fill(t.live.select, label(data, Math.max(0, s.next - 1))));
          break;
        case 'fwd':
          if (qlab) moved(qNext(names, s, now));
          else set(select(data, s, s.next + 1, now), fill(t.live.select, label(data, Math.min(data.scenes.length - 1, s.next + 1))));
          break;
        case 'wselect': set(select(data, s, Number(b.dataset.s), now), fill(t.live.select, label(data, Number(b.dataset.s)))); break;
        case 'scene': set(fireScene(data, s, Number(b.dataset.s), now)); break;
        case 'slot': set(tapSlot(data, s, Number(b.dataset.t), Number(b.dataset.s), now)); break;
        case 'play': set(play(s, now)); break;
        case 'notesOff': set(allNotesOff(s, now), t.live.notesOff); break;
        case 'qgo': {
          const n = qGo(names, s, now);
          set(n, n !== s && n.lastEvent?.kind === 'go' && n.lastEvent.at === now ? fill(t.q.live.go, n.lastEvent.detail ?? '') : undefined);
          break;
        }
        case 'qback': moved(qBack(names, s, now)); break;
        case 'qfwd': moved(qNext(names, s, now)); break;
        case 'qrow': moved(qSetPlayhead(names, s, Number(b.dataset.i), now)); break;
        case 'qpanic': set(qPanic(s, now), reachable(s) ? t.q.live.panic : undefined); break;
        case 'qfollow': follow = !follow; lastScroll = ''; render(); break;
        case 'pane': set(setPane(s, b.dataset.pane as Pane)); break;
        case 'paneOff': break;
        case 'wpage': set(setWatchPage(s, Number(b.dataset.p) as WatchPage)); break;
        case 'stopMain': set(stopMain(s, now), t.live.mainStopped); break;
        case 'askSwitch': set(askSwitch(s)); root.querySelector<HTMLElement>('[data-hold="switch"]')?.focus(); break;
        case 'cancel': set(cancelSwitch(s)); break;
        case 'reset': lastMap = ''; lastScroll = ''; set(initial(data, now, s.mode), t.live.reset); break;
      }
    });
    function moved(n: DemoState) {
      const ev = n.lastEvent;
      set(n, n !== s && ev?.kind === 'playhead' ? fill(t.q.live.playhead, ev.detail ?? '') : undefined);
    }
    el<HTMLInputElement>('qSearch').addEventListener('input', (e) => {
      query = (e.target as HTMLInputElement).value;
      render();
    });

    // long presses: Stop, unlocking the show lock and "Hold to switch" (pointer or Space/Enter held 1 s)
    function holdable(b: HTMLElement, done: () => void, tooShort?: () => void) {
      let timer = 0;
      let fired = false;
      // The click that follows a press is already handled here (data-pressed-at), so a click
      // listener can tell a press from an activation without a pointer (for example VoiceOver).
      const begin = () => {
        fired = false;
        b.classList.add('holding');
        timer = window.setTimeout(() => {
          fired = true;
          b.classList.remove('holding');
          b.dataset.pressedAt = String(Date.now());
          done();
        }, HOLD_MS);
      };
      const end = () => {
        if (!b.classList.contains('holding')) return;
        window.clearTimeout(timer);
        b.classList.remove('holding');
        b.dataset.pressedAt = String(Date.now());
        if (!fired && tooShort) tooShort();
      };
      b.addEventListener('pointerdown', (e) => { if (e.button === 0) begin(); });
      b.addEventListener('pointerup', end);
      b.addEventListener('pointerleave', end);
      b.addEventListener('pointercancel', end);
      b.addEventListener('keydown', (e) => { if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) { e.preventDefault(); begin(); } });
      b.addEventListener('keyup', (e) => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); end(); } });
      b.addEventListener('contextmenu', (e) => e.preventDefault());
    }
    holdable(root.querySelector('[data-hold="stop"]')!, () => set(stop(data, s, Date.now())), () => set(hint(s, 'stopHold', Date.now())));
    holdable(
      root.querySelector('[data-hold="qstop"]')!,
      () => set(qStop(s, Date.now()), reachable(s) ? t.q.live.stopped : undefined),
      () => set(hint(s, 'stopHold', Date.now())),
    );
    holdable(root.querySelector('[data-hold="switch"]')!, () => set(switchToBackup(s, Date.now()), t.live.switched));
    // Show lock: a tap turns it on; turning it off needs the 1 s hold (as in the app).
    all('[data-lock]').forEach((lock) => {
      lock.addEventListener('click', () => {
        if (Date.now() - Number(lock.dataset.pressedAt || 0) < 600) return;
        if (!s.locked) set(setLock(s, true), t.lock);
      });
      holdable(
        lock,
        () => { if (s.locked) set(setLock(s, false)); },
        () => { if (!s.locked) set(setLock(s, true), t.lock); else set(hint(s, 'unlockHold', Date.now())); },
      );
    });
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape' && s.confirming) set(cancelSwitch(s)); });

    render();
    // time left, position, the 3 s banner and short messages
    window.setInterval(render, 250);
  }

  document.querySelectorAll<HTMLElement>('[data-demo]').forEach(start);
</script>

<style>
  .demo-title,
  .demo-lead {
    text-align: left;
  }
  .demo-title {
    margin-bottom: 8px;
  }
  .demo-lead {
    margin: 0 0 28px;
    color: var(--sec);
    font-size: 15px;
  }
  .demo-fallback {
    width: 100%;
    max-width: 760px;
    height: auto;
    border-radius: 14px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .demo-root {
    --ok: #4fd06a;
    --ok-text: #1b7a31;
    --acc: #5aa9ff;
    --danger: #c0241a;
    --warn: #f2b13a;
    --cell: #2c2c2e;
    --appcard: #1c1c1e;
    --appsub: #aeaeb2;
    --go-text: #0a2410;
  }
  @media (prefers-color-scheme: dark) {
    .demo-root {
      --ok-text: #4fd06a;
    }
  }
  :where(.demo-root) button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .demo-root button:focus-visible {
    outline: 3px solid var(--acc);
    outline-offset: 2px;
  }
  .demo-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 348px;
    gap: 32px;
    align-items: start;
  }

  /* ---------- the phone (app points: 1 pt = --p) ---------- */
  .phone {
    background: #0b0b0d;
    border: 1.5px solid #3a3a3c;
    border-radius: 46px;
    padding: 12px;
    box-shadow: var(--shadow);
  }
  .screen {
    container-type: inline-size;
    aspect-ratio: 874 / 402;
    border-radius: 34px;
    overflow: hidden;
    background: #000;
  }
  .app {
    --p: calc(100cqw / 874);
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    color: #f2f2f7;
    font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Noto Sans JP', 'Noto Sans CJK JP', sans-serif;
    font-size: calc(var(--p) * 13);
    line-height: 1.25;
    -webkit-user-select: none;
    user-select: none;
  }
  .app button {
    border: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .tb {
    flex: none;
    display: flex;
    align-items: center;
    gap: calc(var(--p) * 10);
    height: calc(var(--p) * 56);
    padding: 0 calc(var(--p) * 14) 0 calc(var(--p) * 22);
    background: #121214;
    border-bottom: 1px solid #38383a;
  }
  .tb-status {
    display: flex;
    align-items: center;
    gap: calc(var(--p) * 9);
    min-width: 0;
    width: calc(var(--p) * 190);
  }
  .tb-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .tb-text b {
    font-size: calc(var(--p) * 14);
    white-space: nowrap;
  }
  .tb-text small {
    font-size: calc(var(--p) * 10.5);
    color: var(--appsub);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tb-text small.bad {
    color: #ff6b5e;
  }
  .tb-text small.warn {
    color: var(--warn);
  }
  .dot {
    flex: none;
    width: calc(var(--p) * 10);
    height: calc(var(--p) * 10);
    border-radius: 50%;
    background: var(--ok);
  }
  .dot.bad {
    background: var(--danger);
  }
  .dot.warn {
    background: var(--warn);
  }
  .tb-transport {
    display: flex;
    align-items: center;
    gap: calc(var(--p) * 8);
