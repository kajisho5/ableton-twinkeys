---
// "Try it": a working sample of TwinKeys Remote (GO and Session) and the Apple Watch app, with the two
// Macs and the connection map. Fictional data; nothing is sent anywhere. Design: docs/design-site-demo.md
import { url, type Lang } from '../lib/i18n';
import { demoText } from '../lib/remote-demo-text';
import { demoData, initial, formatLeft, secondsLeft, progress, position, label } from '../lib/remote-demo';
import { mapSvg, mapSummary } from '../lib/remote-demo-map';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = demoText[lang];
const data = demoData(d.scenes);
// The page is built ahead of time: draw the first state at a fixed moment; the script takes over.
const now = 0;
const st = initial(data, now);
const left = secondsLeft(st, now);
const fill = (s: string, x: string) => s.replace('{x}', x).replace('{n}', x).replace('{name}', x);
const paneKeys = ['session', 'mixer', 'cues', 'go', 'settings'] as const;
---
<section class="section section-alt demo" aria-labelledby="demo">
  <div class="wrap">
    <h2 class="section-title demo-title" id="demo">{d.title}</h2>
    <p class="demo-lead">{d.lead}</p>

    <div class="demo-root" data-demo>
      <script type="application/json" data-demo-text set:html={JSON.stringify(d)} />
      <div class="demo-grid">
        <div class="phone">
          <div class="screen">
            <div class="app" data-el="app" data-pane="go">
              <header class="tb">
                <div class="tb-status">
                  <span class="dot ok" data-el="dot"></span>
                  <span class="tb-text">
                    <b data-el="macName">{d.mainMac}</b>
                    <small data-el="statusLine">{d.statusOk}</small>
                  </span>
                </div>
                <div class="tb-transport">
                  <button class="tbtn play" data-act="play" aria-label={d.play}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4l13 8-13 8z" /></svg>
                  </button>
                  <button class="tbtn stop" data-hold="stop" aria-label={d.stop}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1.5" /></svg>
                    <span class="holdfill" aria-hidden="true"></span>
                  </button>
                  <span class="tempo">124.00<small>BPM</small></span>
                  <span class="pos" data-el="pos">{position(st, now)}</span>
                </div>
                <div class="tb-right">
                  <button class="anf" data-act="notesOff">{d.allNotesOff}</button>
                  <button class="lockbtn" data-el="lock" aria-label={d.lock} aria-pressed="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path class="shackle" d="M8 11V8a4 4 0 0 1 8 0" fill="none" stroke-width="2.2" />
                      <rect x="5.5" y="11" width="13" height="9" rx="2" />
                    </svg>
                    <span class="holdfill" aria-hidden="true"></span>
                  </button>
                </div>
              </header>

              <div class="body">
                <div class="content">
                  <div class="banner lost" data-el="lost" hidden>
                    <span data-el="lostText">{fill(d.lostBanner, '3')}</span>
                    <button data-act="askSwitch">{d.switchButton}</button>
                  </div>
                  <div class="banner switched" data-el="switchedBanner" hidden>{fill(d.switchedBanner, d.backupMac)}</div>
                  <div class="notice" data-el="notice" hidden></div>

                  <div class="pane pane-go">
                    <div class="go-left">
                      <div class="card now" data-el="now">
                        <span class="cap ok">{d.nowPlaying}</span>
                        <div class="row big">
                          <span class="idx" data-el="nowIdx">{st.playing !== null ? st.playing + 1 : ''}</span>
                          <span class="nm" data-el="nowName">{st.playing !== null ? data.scenes[st.playing] : d.nothingPlaying}</span>
                        </div>
                        <div class="row left" data-el="nowLeftRow">
                          <span class="cap2">{d.left}</span>
                          <span class="leftv" data-el="nowLeft">{left !== null ? formatLeft(left) : ''}</span>
                          <span class="bar"><span data-el="nowBar" style={`width:${Math.round(progress(st, now) * 100)}%`}></span></span>
                        </div>
                      </div>
                      <div class="card next">
                        <span class="cap acc">{d.next}</span>
                        <div class="row big2">
                          <span class="idx" data-el="nextIdx">{st.next + 1}</span>
                          <span class="nm" data-el="nextName">{data.scenes[st.next]}</span>
                        </div>
                      </div>
                      <div class="spacer"></div>
                      <div class="choose">
                        <button data-act="back">{d.back}</button>
                        <button data-act="fwd">{d.fwd}</button>
                        <span>{d.chooseOnly}</span>
                      </div>
                    </div>
                    <button class="gobtn" data-act="go">
                      <span class="go-big">GO</span>
                      <span class="go-sub">{d.goSub}</span>
                      <span class="go-next" data-el="goNext">{label(data, st.next)}</span>
                      <span class="go-lock">{d.goLock}</span>
                    </button>
                  </div>

                  <div class="pane pane-session">
                    <div class="grid" role="group" aria-label={d.panes.session} style={`--cols:${data.tracks.length}`}>
                      <div class="gh" aria-hidden="true">
                        <span class="gn"></span>
                        {data.tracks.map((tr, t) => <span class="th" style={`--c:${data.colors[t]}`}>{tr}</span>)}
                        <span class="th scene-h">{d.sceneHeader}</span>
                      </div>
                      {data.scenes.map((sc, s) => (
                        <div class="gr">
                          <span class="gn" title={sc}>{s + 1}</span>
                          {data.tracks.map((tr, t) => {
                            const c = data.clips[t][s];
                            return (
                              <button
                                class:list={['slot', c.has ? 'has' : 'empty']}
                                style={`--c:${data.colors[t]}`}
                                data-act="slot"
                                data-t={t}
                                data-s={s}
                                aria-label={c.has ? `${tr} · ${c.name} (${s + 1} ${sc})` : fill(d.stopTrack, tr)}
                              >
                                {c.has ? <span class="cn">{c.name}</span> : <span class="sq" aria-hidden="true"></span>}
                                {c.has && <span class="cl" data-left></span>}
                              </button>
                            );
                          })}
                          <button class="scbtn" data-act="scene" data-s={s} aria-label={fill(d.launchScene, String(s + 1))}>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <nav class="rail" aria-label="TwinKeys Remote">
                  {paneKeys.map((k) => {
                    const live = k === 'session' || k === 'go';
                    return (
                      <button
                        class:list={['ri', `ri-${k}`, { on: k === 'go' }]}
                        data-act={live ? 'pane' : 'paneOff'}
                        data-pane={k}
                        aria-disabled={live ? undefined : 'true'}
                        title={live ? undefined : d.paneOff}
                        aria-current={k === 'go' ? 'page' : undefined}
                      >
                        <span class="rico" aria-hidden="true"></span>
                        <span class="rl">{d.panes[k]}</span>
                      </button>
                    );
                  })}
                </nav>
              </div>

              <div class="sheet" data-el="sheet" hidden role="dialog" aria-modal="true" aria-labelledby="demo-sheet-t">
                <div class="sheet-box">
                  <b id="demo-sheet-t">{d.confirmTitle}</b>
                  <p>{fill(d.confirmBody, d.backupMac)}</p>
                  <p class="pt">{fill(d.confirmPhone, d.backupMac)}</p>
                  <p class="pt">{fill(d.confirmKeys, d.backupMac)}</p>
                  <div class="sheet-btns">
                    <button class="cancel" data-act="cancel">{d.cancel}</button>
                    <button class="holdbtn" data-hold="switch">
                      <span class="holdfill" aria-hidden="true"></span>
                      <span class="hb-t">{d.hold}</span>
                      <small>{d.holdSecond}</small>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="side">
          <div class="watch-row">
            <div class="watch-wrap">
              <div class="watch" aria-label={d.watchTitle} role="group">
                <span class="crown" aria-hidden="true"></span><span class="sidebtn" aria-hidden="true"></span>
                <div class="wscreen" data-el="wscreen" data-page="0">
                  <div class="wpage wp0">
                    <span class="wnext" data-el="wnext">{fill(d.watchNext, label(data, st.next))}</span>
                    <button class="wgo" data-act="go" aria-label={`GO: ${label(data, st.next)}`}>GO</button>
                    <span class="whint" data-el="whint">{d.crownHint}</span>
                  </div>
                  <div class="wpage wp1">
                    <span class="wcap" data-el="wcap1">{d.chooseScene}</span>
                    <div class="wlist">
                      {data.scenes.map((sc, s) => (
                        <button class="wsc" data-act="wselect" data-s={s}>
                          <span class="wn">{s + 1}</span><span class="wt">{sc}</span><span class="wm" aria-hidden="true"></span>
                        </button>
                      ))}
                    </div>
                  </div>
                  <div class="wpage wp2">
                    <span class="wlinks" data-el="wlinks">{d.watchLinks}</span>
                    <button class="wanf" data-act="notesOff">{d.allNotesOff}</button>
                    <span class="wlast" data-el="wlast">{d.lastCueNone}</span>
                  </div>
                </div>
              </div>
              <div class="dots" role="group" aria-label={d.watchTitle}>
                {d.watchPages.map((p, i) => (
                  <button class:list={['wdot', { on: i === 0 }]} data-act="wpage" data-p={i} aria-label={p} aria-pressed={i === 0 ? 'true' : 'false'}></button>
                ))}
              </div>
            </div>
            <div class="watch-copy">
              <b>{d.watchTitle}</b>
              <p>{d.watchDesc}</p>
              <p>{d.watchHint}</p>
              <div class="crown-btns">
                <button data-act="back">{d.crownBack}</button>
                <button data-act="fwd">{d.crownNext}</button>
              </div>
              <small>{d.crownNote}</small>
            </div>
          </div>

          <div class="macs">
            {(['main', 'backup'] as const).map((k) => (
              <div class="mac ok" data-el={`mac-${k}`}>
                <div class="mac-h">
                  <svg viewBox="0 0 28 22" aria-hidden="true"><rect x="2" y="2" width="24" height="15" rx="2.5" /><rect x="10" y="18" width="8" height="2.5" /></svg>
                  <b>{k === 'main' ? d.mainMac : d.backupMac}</b>
                </div>
                <div class="mac-s">
                  <span class="mac-live" data-part="live">● {d.liveOk}</span>
                  <span class="mac-badge" data-part="badge" hidden={k !== 'main'}>{d.mainBadge}</span>
                </div>
                <div class="mac-line" data-part="line">▶ {st.playing !== null ? label(data, st.playing) : ''}</div>
                <div class="mac-recv" data-part="recv" aria-hidden="true"></div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="map" data-el="map">
        <b class="map-title">{d.mapTitle}</b>
        <div class="map-pics" data-el="mapPics" role="img" aria-label={mapSummary('ok', d)}>
          <Fragment set:html={mapSvg('ok', d, false) + mapSvg('ok', d, true)} />
        </div>
      </div>

      <div class="controls">
        <button class="ctl stopmain" data-act="stopMain">{d.stopMain}</button>
        <button class="ctl" data-act="reset">{d.reset}</button>
        <p>{d.controlsNote1}<br />{d.controlsNote2}</p>
      </div>
      <p class="foot">{d.foot1}<br />{d.foot2}</p>
      <p class="sr-only" aria-live="polite" data-el="live"></p>
    </div>

    <noscript>
      <img class="demo-fallback" src={url('images/remote-session.png')} width="1311" height="603" alt={d.fallbackAlt} loading="lazy" />
    </noscript>
  </div>
</section>

<script>
  import {
    demoData, initial, go, select, fireScene, tapSlot, play, stop, allNotesOff, hint, setLock, setPane,
    setWatchPage, stopMain, askSwitch, cancelSwitch, switchToBackup, secondsLeft, progress, formatLeft,
    position, showsLostBanner, lostSeconds, linkState, visibleNotice, recentEvent, label, reachable,
    type DemoState, type Pane, type WatchPage,
  } from '../lib/remote-demo';
  import { mapSvg, mapSummary } from '../lib/remote-demo-map';
  import type { DemoText } from '../lib/remote-demo-text';

  const HOLD_MS = 1000;

  function start(root: HTMLElement) {
    const t: DemoText = JSON.parse(root.querySelector('[data-demo-text]')!.textContent || '{}');
    const data = demoData(t.scenes);
    let s: DemoState = initial(data, Date.now());
    let lastMap = '';
    let lastLive = '';
    const el = <T extends HTMLElement = HTMLElement>(name: string) => root.querySelector<T>(`[data-el="${name}"]`)!;
    const all = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));
    const fill = (str: string, x: string) => str.replace('{x}', x).replace('{n}', x).replace('{name}', x);
    const announce = (msg: string) => {
      if (msg === lastLive) return;
      lastLive = msg;
      el('live').textContent = msg;
    };

    function set(n: DemoState, msg?: string) {
      s = n;
      render();
      if (msg) announce(msg);
    }

    function render() {
      const now = Date.now();
      const app = el('app');
      app.dataset.pane = s.pane;
      // top bar
      const ls = linkState(s);
      el('macName').textContent = s.switched ? t.backupMac : t.mainMac;
      el('statusLine').textContent = ls === 'ok' ? t.statusOk : ls === 'dead' ? t.statusLost : t.statusSwitched;
      el('statusLine').className = ls === 'dead' ? 'bad' : ls === 'switched' ? 'warn' : '';
      el('dot').className = `dot ${ls === 'dead' ? 'bad' : ls === 'switched' ? 'warn' : 'ok'}`;
      el('pos').textContent = position(s, now);
      root.querySelector('[data-act="play"]')!.classList.toggle('on', s.running);
      const lock = el('lock');
      lock.classList.toggle('on', s.locked);
      lock.setAttribute('aria-pressed', String(s.locked));
      lock.setAttribute('aria-label', s.locked ? t.unlock : t.lock);
      // banners and notices
      const lost = el('lost');
      lost.hidden = !showsLostBanner(s, now);
      el('lostText').textContent = fill(t.lostBanner, String(lostSeconds(s, now)));
      el('switchedBanner').hidden = !(s.switched && now - (s.notice?.at ?? 0) < 6000 && s.notice?.kind === 'switched');
      const nk = visibleNotice(s, now);
      const notice = el('notice');
      notice.hidden = !nk || nk === 'switched';
      notice.textContent = nk ? t.notice[nk] : '';
      notice.className = `notice ${nk === 'unreachable' ? 'bad' : ''}`;
      el('sheet').hidden = !s.confirming;
      // GO pane
      const left = secondsLeft(s, now);
      el('nowIdx').textContent = s.playing !== null ? String(s.playing + 1) : '';
      el('nowName').textContent = s.playing !== null ? data.scenes[s.playing] : t.nothingPlaying;
      el('now').classList.toggle('idle', s.playing === null);
      el('nowLeftRow').hidden = left === null;
      el('nowLeft').textContent = left !== null ? formatLeft(left) : '';
      el('nowBar').style.width = `${Math.round(progress(s, now) * 100)}%`;
      const hasNext = s.next >= 0 && s.next < data.scenes.length;
      el('nextIdx').textContent = hasNext ? String(s.next + 1) : '';
      el('nextName').textContent = hasNext ? data.scenes[s.next] : t.endOfList;
      el('goNext').textContent = hasNext ? label(data, s.next) : t.endOfList;
      all('[data-act="go"]').forEach((b) => {
        b.classList.toggle('end', !hasNext);
        b.setAttribute('aria-disabled', String(!hasNext));
      });
      all('[data-act="back"]').forEach((b) => b.toggleAttribute('disabled', s.next <= 0));
      all('[data-act="fwd"]').forEach((b) => b.toggleAttribute('disabled', s.next >= data.scenes.length - 1));
      // session
      all('[data-act="slot"]').forEach((b) => {
        const tr = Number(b.dataset.t), sc = Number(b.dataset.s);
        const on = s.trackSlot[tr] === sc;
        b.classList.toggle('playing', on);
        const lt = b.querySelector('[data-left]');
        if (lt) lt.textContent = on && left !== null ? formatLeft(left) : '';
      });
      all('[data-act="scene"]').forEach((b) => b.classList.toggle('on', Number(b.dataset.s) === s.playing));
      all('.gr').forEach((r, i) => r.classList.toggle('sel', i === s.next));
      all('[data-act="pane"]').forEach((b) => {
        const on = b.dataset.pane === s.pane;
        b.classList.toggle('on', on);
        if (on) b.setAttribute('aria-current', 'page'); else b.removeAttribute('aria-current');
      });
      // watch
      el('wscreen').dataset.page = String(s.watchPage);
      all('[data-act="wpage"]').forEach((b) => {
        const on = Number(b.dataset.p) === s.watchPage;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      el('wnext').textContent = hasNext ? fill(t.watchNext, label(data, s.next)) : t.endOfList;
      const wgo = root.querySelector('.wgo')!;
      wgo.setAttribute('aria-label', hasNext ? `GO: ${label(data, s.next)}` : `GO: ${t.endOfList}`);
      el('whint').textContent = nk && nk !== 'switched' ? t.notice[nk] : t.crownHint;
      el('whint').className = `whint ${nk === 'unreachable' ? 'bad' : ''}`;
      all('[data-act="wselect"]').forEach((b) => {
        const sc = Number(b.dataset.s);
        b.classList.toggle('playing', sc === s.playing);
        b.classList.toggle('next', sc === s.next);
      });
      el('wlinks').textContent = reachable(s) ? (s.switched ? `${t.backupMac} ✓` : t.watchLinks) : t.watchLinksLost;
      const ev = s.lastEvent;
      el('wlast').textContent = ev ? fill(t.lastCue, t.events[ev.kind]) : t.lastCueNone;
      // Macs
      const recent = recentEvent(s, now);
      for (const k of ['main', 'backup'] as const) {
        const card = el(`mac-${k}`);
        const dead = k === 'main' && s.main === 'dead';
        card.className = `mac ${dead ? 'dead' : 'ok'}`;
        card.querySelector('[data-part="live"]')!.textContent = dead ? `● ${t.noAnswer}` : `● ${t.liveOk}`;
        const isMain = (k === 'main' && !s.switched) || (k === 'backup' && s.switched);
        (card.querySelector('[data-part="badge"]') as HTMLElement).hidden = !isMain || dead;
        card.querySelector('[data-part="line"]')!.textContent = dead
          ? t.stoppedNote
          : s.playing !== null ? `▶ ${label(data, s.playing)}` : t.stoppedLine;
        const recv = card.querySelector('[data-part="recv"]') as HTMLElement;
        const got = !!recent && !dead && reachable(s);
        recv.textContent = got ? fill(t.received, t.events[recent!.kind]) : '';
        recv.classList.toggle('on', got);
      }
      // connection map
      if (ls !== lastMap) {
        lastMap = ls;
        const pics = el('mapPics');
        pics.innerHTML = mapSvg(ls, t, false) + mapSvg(ls, t, true);
        pics.setAttribute('aria-label', mapSummary(ls, t));
      }
      (root.querySelector('[data-act="stopMain"]') as HTMLButtonElement).disabled = s.main === 'dead';
    }

    // taps
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
      if (!b || !root.contains(b) || b.hasAttribute('disabled')) return;
      const now = Date.now();
      const act = b.dataset.act;
      switch (act) {
        case 'go': {
          const n = go(data, s, now);
          set(n, n.lastEvent?.kind === 'go' && n !== s ? fill(t.live.go, label(data, n.playing ?? 0)) : undefined);
          break;
        }
        case 'back': set(select(data, s, s.next - 1, now), fill(t.live.select, label(data, Math.max(0, s.next - 1)))); break;
        case 'fwd': set(select(data, s, s.next + 1, now), fill(t.live.select, label(data, Math.min(data.scenes.length - 1, s.next + 1)))); break;
        case 'wselect': set(select(data, s, Number(b.dataset.s), now), fill(t.live.select, label(data, Number(b.dataset.s)))); break;
        case 'scene': set(fireScene(data, s, Number(b.dataset.s), now)); break;
        case 'slot': set(tapSlot(data, s, Number(b.dataset.t), Number(b.dataset.s), now)); break;
        case 'play': set(play(s, now)); break;
        case 'notesOff': set(allNotesOff(s, now), t.live.notesOff); break;
        case 'pane': set(setPane(s, b.dataset.pane as Pane)); break;
        case 'paneOff': break;
        case 'wpage': set(setWatchPage(s, Number(b.dataset.p) as WatchPage)); break;
        case 'stopMain': set(stopMain(s, now), t.live.mainStopped); break;
        case 'askSwitch': set(askSwitch(s)); root.querySelector<HTMLElement>('[data-hold="switch"]')?.focus(); break;
        case 'cancel': set(cancelSwitch(s)); break;
        case 'reset': set(initial(data, now), t.live.reset); lastMap = ''; render(); break;
      }
    });

    // long presses: Stop, unlocking the show lock and "Hold to switch" (pointer or Space/Enter held 1 s)
    function holdable(b: HTMLElement, done: () => void, tooShort?: () => void) {
      let timer = 0;
      let fired = false;
      // The click that follows a press is already handled here (data-pressed-at), so a click
      // listener can tell a press from an activation without a pointer (for example VoiceOver).
      const begin = () => {
        fired = false;
        b.classList.add('holding');
        timer = window.setTimeout(() => {
          fired = true;
          b.classList.remove('holding');
          b.dataset.pressedAt = String(Date.now());
          done();
        }, HOLD_MS);
      };
      const end = () => {
        if (!b.classList.contains('holding')) return;
        window.clearTimeout(timer);
        b.classList.remove('holding');
        b.dataset.pressedAt = String(Date.now());
        if (!fired && tooShort) tooShort();
      };
      b.addEventListener('pointerdown', (e) => { if (e.button === 0) begin(); });
      b.addEventListener('pointerup', end);
      b.addEventListener('pointerleave', end);
      b.addEventListener('pointercancel', end);
      b.addEventListener('keydown', (e) => { if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) { e.preventDefault(); begin(); } });
      b.addEventListener('keyup', (e) => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); end(); } });
      b.addEventListener('contextmenu', (e) => e.preventDefault());
    }
    holdable(root.querySelector('[data-hold="stop"]')!, () => set(stop(data, s, Date.now())), () => set(hint(s, 'stopHold', Date.now())));
    holdable(root.querySelector('[data-hold="switch"]')!, () => set(switchToBackup(s, Date.now()), t.live.switched));
    // Show lock: a tap turns it on; turning it off needs the 1 s hold (as in the app).
    const lock = el('lock');
    lock.addEventListener('click', () => {
      if (Date.now() - Number(lock.dataset.pressedAt || 0) < 600) return;
      if (!s.locked) set(setLock(s, true), t.lock);
    });
    holdable(
      lock,
      () => { if (s.locked) set(setLock(s, false)); },
      () => { if (!s.locked) set(setLock(s, true), t.lock); else set(hint(s, 'unlockHold', Date.now())); },
    );
    root.addEventListener('keydown', (e) => { if (e.key === 'Escape' && s.confirming) set(cancelSwitch(s)); });

    render();
    // time left, position, the 3 s banner and short messages
