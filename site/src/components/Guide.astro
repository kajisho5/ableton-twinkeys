---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../lib/i18n';

// One Markdown page from docs/: the guide (docs/help), the privacy policy (docs/privacy) or support (docs/support).
type Doc = 'guide' | 'privacy' | 'support';

interface Props {
  lang: Lang;
  doc?: Doc;
}
const { lang, doc = 'guide' } = Astro.props;
const s = t[lang];
const source = {
  guide: { collection: 'help', title: s.guideDocTitle, description: undefined },
  privacy: { collection: 'privacy', title: s.privacyDocTitle, description: s.privacyDescription },
  support: { collection: 'support', title: s.supportDocTitle, description: s.supportDescription },
} as const;
const { collection, title, description } = source[doc];
const entry = await getEntry(collection, lang);
if (!entry) throw new Error(`docs/${collection}/${lang}.md not found`);
const { Content } = await render(entry);
---
<Base lang={lang} page={doc} title={title} description={description}>
  <article class="wrap narrow prose guide">
    <Content />
  </article>
</Base>

<style>
  .guide {
    padding-top: 40px;
    padding-bottom: 72px;
  }
  .guide :global(h1) {
    margin: 0 0 16px;
    font-size: 36px;
    font-weight: 800;
    line-height: 1.3;
  }
  .guide :global(h2) {
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .guide {
      padding-top: 28px;
      padding-bottom: 48px;
    }
    .guide :global(h1) {
      font-size: 28px;
    }
  }
</style>
