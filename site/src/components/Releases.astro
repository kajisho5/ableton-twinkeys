---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../lib/i18n';
import { getReleases } from '../lib/releases';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const KINDS: Record<string, string> = {
  new: 'new',
  '新しくなったこと': 'new',
  fixed: 'fixed',
  '直した不具合': 'fixed',
};

/**
 * Release-note sections are `##` in the Markdown. Under the version heading they become h3,
 * get a version-scoped id (ids must be unique on the page) and a class for the accent bar:
 * New / 新しくなったこと -> blue, Fixed / 直した不具合 -> red.
 */
function sectionize(html: string, version: string): string {
  return html.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_m, attrs: string, inner: string) => {
    const label = inner.replace(/<[^>]+>/g, '').trim();
    const kind = KINDS[label.toLowerCase()];
    const id = /id="([^"]*)"/.exec(attrs)?.[1] ?? label;
    const cls = kind ? ` class="rn-${kind}"` : '';
    return `<h3 id="v${version}-${id}"${cls}>${inner}</h3>`;
  });
}

const releases = (await getReleases(lang)).map((entry) => ({
  entry,
  html: sectionize(entry.rendered?.html ?? '', entry.data.version),
}));
---
<Base lang={lang} page="releases" title={s.releasesDocTitle} description={s.releasesLead}>
  <div class="wrap narrow releases">
    <header class="page-head">
      <h1>{s.releasesTitle}</h1>
      <p class="lead">{s.releasesLead}</p>
    </header>
    {releases.map(({ entry, html }, i) => (
      <section class="release" id={`v${entry.data.version}`} aria-labelledby={`h-${entry.data.version}`}>
        <div class="release-head">
          <h2 id={`h-${entry.data.version}`}>{entry.data.version}</h2>
          <time datetime={entry.data.date}>{entry.data.date}</time>
          {i === 0 && <span class="badge">{s.latest}</span>}
        </div>
        <div class="release-body" set:html={html} />
      </section>
    ))}
  </div>
</Base>

<style>
  .releases {
    padding-bottom: 72px;
  }
  .page-head {
    padding-bottom: 40px;
  }
  .release {
    border-top: 1px solid var(--line);
    padding: 22px 0 28px;
  }
  .release-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 32px;
  }
  .release-head h2 {
    margin: 0;
    font-size: 26px;
    font-weight: 800;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }
  .release-head time {
    color: var(--sec);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .badge {
    align-self: center;
    margin-left: 22px;
    display: inline-block;
    min-width: 60px;
    padding: 2px 14px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 13px;
    font-weight: 700;
    line-height: 22px;
    text-align: center;
  }
  .release-body :global(h3) {
    position: relative;
    margin: 18px 0 2px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.5;
  }
  .release-body :global(h3.rn-new)::before,
  .release-body :global(h3.rn-fixed)::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 50%;
    width: 4px;
    height: 20px;
    margin-top: -10px;
    border-radius: 2px;
    background: var(--accent);
  }
  .release-body :global(h3.rn-fixed)::before {
    background: var(--fixed);
  }
  .release-body :global(ul) {
    margin: 0;
    padding-left: 22px;
    list-style: none;
  }
  .release-body :global(li) {
    position: relative;
    padding-left: 1em;
    font-size: 15px;
    line-height: 26px;
  }
  .release-body :global(li)::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--sec);
  }
  .releases:lang(ja) .release-body :global(li)::before {
    content: '・';
    left: -0.1em;
  }
  .release-body :global(p) {
    margin: 0 0 4px;
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .page-head {
      padding-bottom: 28px;
    }
    .release-head {
      gap: 4px 16px;
    }
    .badge {
      margin-left: 0;
    }
    .release-body :global(h3.rn-new),
    .release-body :global(h3.rn-fixed) {
      padding-left: 12px;
    }
    .release-body :global(h3.rn-new)::before,
    .release-body :global(h3.rn-fixed)::before {
      left: 0;
    }
    .release-body :global(ul) {
      padding-left: 4px;
    }
  }
</style>
